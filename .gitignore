# ==========================================
# CARDIOAI Root .gitignore
# ==========================================

# Virtual Environments (Python)
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node.js / Frontend dependencies & build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
dist/
build/

# Environment files & Secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
